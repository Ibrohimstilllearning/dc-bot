# Ambil dari Discord Developer Portal > Applications > (bot kamu) > Bot > Token
DISCORD_TOKEN=

# Ambil dari Discord Developer Portal > Applications > (bot kamu) > General Information > Application ID
CLIENT_ID=

# Opsional: isi Server ID (klik kanan nama server di Discord > Copy Server ID, aktifkan Developer Mode dulu)
# Kalau diisi, slash command langsung muncul instan di server itu (buat testing).
# Kalau dikosongkan, command didaftarkan global (butuh ~1 jam buat muncul, tapi jalan di semua server).
GUILD_ID=
